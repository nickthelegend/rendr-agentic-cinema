# Copy to .env.local. Never commit either.

# An AI Studio key from aistudio.google.com — a different product from a
# Gemini app subscription, which carries no API quota however much it
# includes in the app.
GEMINI_API_KEY=

# Clickhouse Cloud, for the generation ledger. Optional: without it a render
# works identically, minus the history. VITE_ prefixed because the renderer
# reads them.
VITE_CLICKHOUSE_URL=
VITE_CLICKHOUSE_USER=default
VITE_CLICKHOUSE_PASSWORD=
