# Copy to .env.local. Never commit either.

# An AI Studio key from aistudio.google.com — a different product from a
# Gemini app subscription, which carries no API quota however much it
# includes in the app.
GEMINI_API_KEY=

# Clickhouse Cloud, for the generation ledger.
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
